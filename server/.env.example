# Copy to .env (in this directory) and fill in real values. Never commit .env.

PORT=4300
DB_PATH=./data/dev.sqlite

# AES-256-GCM key for provider credentials at rest (../crypto.ts) — base64,
# must decode to exactly 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Deliberately a separate key from iptv-recorder's and iptv-scheduler's own
# ENCRYPTION_KEY — three independent services/secrets stores.
ENCRYPTION_KEY=
